{
  "expo": {
    "name": "Between Us",
    "slug": "between-us",
    "version": "0.6.0",
    "orientation": "default",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "between-us",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oxieg3n.betweenus",
      "buildNumber": "5"
    },
    "android": {
      "package": "com.oxieg3n.betweenus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#F7FAFC"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 5
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC",
          "image": "./assets/brand/symbol.png",
          "imageWidth": 160
        }
      ],
      "llama.rn",
      "./plugins/with-short-native-paths",
      "./plugins/with-adaptive-display",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Unlock your own private journal on this device."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your own private journal on this device."
        }
      ],
      "./plugins/withProductionSigning.cjs",
      "./plugins/withProductionTransport.cjs",
      "./plugins/withWritingConfiguration.cjs",
      "./plugins/withPrivateCapturePermissions.cjs"
    ],
    "extra": {
      "buildId": "1116-FinanceCheckpoints-r1"
    }
  }
}
