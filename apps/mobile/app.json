{
  "expo": {
    "name": "Between Us",
    "slug": "between-us",
    "version": "0.3.0",
    "orientation": "default",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "between-us",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oxieg3n.betweenus"
    },
    "android": {
      "package": "com.oxieg3n.betweenus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#F7FAFC"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC",
          "image": "./assets/brand/symbol.png",
          "imageWidth": 160
        }
      ],
      "llama.rn",
      "./plugins/with-short-native-paths"
    ],
    "extra": {
      "buildId": "1115-FamilyEnvelopes-Journal-r3"
    }
  }
}
